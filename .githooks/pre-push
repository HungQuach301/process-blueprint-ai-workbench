#!/usr/bin/env bash
# Deterministic push guards (Bài 0E): typecheck passes; no lint errors and warnings <= baseline; no force-push to master/main.
set -uo pipefail

LINT_WARNING_BASELINE=20

if [ -f package.json ]; then
  if grep -q '"typecheck"' package.json ; then
    echo "pre-push: typecheck..." >&2
    if ! npm run typecheck ; then
      echo "ERROR: typecheck failed — fix before pushing." >&2
      exit 1
    fi
  fi
  if grep -q '"lint"' package.json ; then
    echo "pre-push: lint (errors block; warnings must stay <= $LINT_WARNING_BASELINE)..." >&2
    if ! npm run lint -- --max-warnings "$LINT_WARNING_BASELINE" ; then
      echo "ERROR: lint has errors, or warnings exceed baseline ($LINT_WARNING_BASELINE)." >&2
      echo "       Fix it, or if warnings were intentionally reduced, lower LINT_WARNING_BASELINE in .githooks/pre-push." >&2
      exit 1
    fi
  fi
  if grep -q '"test:normalizer"' package.json ; then
    echo "pre-push: normalizer unit tests..." >&2
    if ! npm run test:normalizer ; then
      echo "ERROR: normalizer tests failed — fix failing fixtures before pushing." >&2
      exit 1
    fi
  fi
fi

protected_re='^(refs/heads/)?(master|main)$'
while read -r local_ref local_sha remote_ref remote_sha ; do
  if [[ "$remote_ref" =~ $protected_re ]]; then
    if [[ "$remote_sha" != "0000000000000000000000000000000000000000" ]]; then
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "ERROR: refusing force-push to protected branch ($remote_ref)." >&2
        exit 1
      fi
    fi
  fi
done
exit 0
