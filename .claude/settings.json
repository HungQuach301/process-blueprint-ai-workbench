{
  "_comment": "Hook registration. Verify schema at code.claude.com/docs/en/hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/typecheck-on-edit.sh" },
          { "type": "command", "command": ".claude/hooks/lint-on-edit.sh" }
        ]
      }
    ]
  }
}
