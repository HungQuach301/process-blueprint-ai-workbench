{
  "_comment": "Hook registration. Verify schema at code.claude.com/docs/en/hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/typecheck-on-edit.sh" },
          { "type": "command", "command": ".claude/hooks/lint-on-edit.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob", "Edit", "Write",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git branch:*)",
      "Bash(git add:*)", "Bash(git checkout:*)",
      "Bash(npm run typecheck)", "Bash(npm run lint)", "Bash(npm run test:normalizer)"
    ],
    "ask": [
      "Bash(git commit:*)", "Bash(git merge:*)", "Bash(git push:*)",
      "Bash(git reset:*)", "Bash(git restore:*)", "Bash(rm:*)",
      "Bash(npm run eval:baseline:*)", "Bash(npm run calibration:*)"
    ]
  }
}