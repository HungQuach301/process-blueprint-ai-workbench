{
  "name": "process-blueprint-ai-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:eval": "npx tsx evals/input-brief-to-ptr/run-eval.ts",
    "test:eval:process-improvement": "npx tsx evals/process-improvement-recommendation/run-eval.ts",
    "test:eval:artifact-review": "npx tsx evals/artifact-review/run-eval.ts",
    "test:eval:dry-run": "npx tsx evals/input-brief-to-ptr/run-eval.ts --dry-run",
    "test:eval:dry-run:process-improvement": "npx tsx evals/process-improvement-recommendation/run-eval.ts --dry-run",
    "test:eval:dry-run:artifact-review": "npx tsx evals/artifact-review/run-eval.ts --dry-run",
    "test:judge": "node --env-file=.env.local node_modules/.bin/tsx evals/common/test-judge.ts",
    "eval:baseline": "node --env-file=.env.local node_modules/.bin/tsx evals/common/baseline.ts",
    "test:normalizer": "node_modules/.bin/tsx evals/normalizer/test-normalizer.ts",
    "calibration:build": "npx tsx evals/calibration/build-labeling-app.ts",
    "calibration:agreement": "npx tsx evals/calibration/agreement.ts",
    "calibration:rejudge": "node --env-file=.env.local node_modules/.bin/tsx evals/calibration/rejudge.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "bpmn-js": "^18.16.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "^16.2.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
