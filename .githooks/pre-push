#!/usr/bin/env bash
# Deterministic push guards (Bài 0E): (1) typecheck + lint must pass, (2) no force-push to master/main.
set -uo pipefail

if [ -f package.json ]; then
  if grep -q '"typecheck"' package.json ; then
    echo "pre-push: typecheck..." >&2
    if ! npm run typecheck ; then
      echo "ERROR: typecheck failed — fix before pushing." >&2
      exit 1
    fi
  fi
  if grep -q '"lint"' package.json ; then
    echo "pre-push: lint (errors only)..." >&2
    if ! npm run lint -- --quiet ; then
      echo "ERROR: lint errors — fix before pushing (warnings are allowed)." >&2
      exit 1
    fi
  fi
fi

protected_re='^(refs/heads/)?(master|main)$'
while read -r local_ref local_sha remote_ref remote_sha ; do
  if [[ "$remote_ref" =~ $protected_re ]]; then
    if [[ "$remote_sha" != "0000000000000000000000000000000000000000" ]]; then
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "ERROR: refusing force-push to protected branch ($remote_ref)." >&2
        exit 1
      fi
    fi
  fi
done
exit 0
